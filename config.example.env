# Copy to `.env` and fill in, or just export these before starting the server.
# MySQL is required. SMTP is optional while automatic meetings are disabled.
# Never commit .env or provider credentials.
PORT=3000
NOTIFY_EMAIL=info@malamin.cc

# Admin access uses the database user seeded with npm run seed-admin.

# --- Hardening (optional) ---
# Trust X-Forwarded-For for rate limiting. Enable ONLY if the app sits behind
# a proxy you control: with this on, a client that sets the header itself can
# rotate it to dodge the limits.
# TRUST_PROXY=1

# Send Strict-Transport-Security. Turn on once you have confirmed the site is
# served over HTTPS. Sending it over plain HTTP risks locking visitors out
# for the max-age period if you later move back to HTTP.
# ENABLE_HSTS=1

# --- Bot protection for the questionnaire (optional) ---
# Cloudflare Turnstile. Get both keys from Cloudflare dashboard -> Turnstile
# -> Add site. You do NOT need an API Token and you do NOT need to move your
# DNS to Cloudflare. Leave both empty and the check is simply skipped.
#
# These are Cloudflare's public test keys. The site key always passes and the
# widget renders visibly, so they are safe to develop against:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
#
# Swap the pair below for the real ones from your dashboard:
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- SMTP (example: Gmail with an App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@malamin.cc
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=info@malamin.cc

# --- Database (MySQL/MariaDB) ---
# Required for admin portal and data persistence
# Create database via cPanel -> MySQL Database Wizard
# DB_HOST=localhost
# DB_USER=your_database_user
# DB_PASS=your_database_password
# DB_NAME=your_database_name

# --- Automatic Zoom / Google Meet (disabled until configured) ---
# Apply migrations/001-meetings.sql first; see MEETINGS-SETUP.md.
MEETINGS_ENABLED=0
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# npm run authorize-google saves this locally; transfer securely to hosting.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
